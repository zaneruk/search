# --- LLM ---------------------------------------------------------------
# openrouter | openai_compatible
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Базовый URL OpenAI-совместимого API (для OpenRouter: https://openrouter.ai/api/v1)
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Быстрая модель (QU, классификация) и сильная модель (enrich, агент, judge).
# Значения ниже — примеры; актуальные тарифы фиксируются в config/price_snapshots.json
LLM_MODEL_FAST=google/gemini-2.5-flash
LLM_MODEL_STRONG=anthropic/claude-sonnet-4.5
# Дневной бюджет LLM в микро-рублях (1 ₽ = 1 000 000 micro_rub): 500000000 = 500 ₽
LLM_DAILY_BUDGET_MICRO_RUB=500000000

# --- Доступ ------------------------------------------------------------
# X-Admin-Token для /v1/admin/*, X-Internal-Token для /internal/*
ADMIN_TOKEN=change-me-admin
INTERNAL_TOKEN=change-me-internal

# --- Хранилище ---------------------------------------------------------
SQLITE_PATH=data/db/smart_search.sqlite
