# --- LLM: Yandex AI Studio --------------------------------------------
LLM_PROVIDER=yandex
OPENAI_BASE_URL=https://ai.api.cloud.yandex.net/v1
LLM_BASE_URL=https://ai.api.cloud.yandex.net/v1
YANDEX_API_KEY= ваш ключ
YANDEX_FOLDER_ID= ваша папка

# --- Роли моделей Yandex AI Studio (полные URI из /v1/models) ----------
# ВАЖНО: в gateway.py если значение начинается с "gpt://", использовать как есть;
# если короткое — собирать f"gpt://{YANDEX_FOLDER_ID}/{model}/latest".

# Задача 1.1 (Онлайн QU: быстрый разбор запроса, <1500 мс, effort не передавать)
LLM_MODEL_FAST=gpt://FOLDER_ID/aliceai-llm-flash/latest

# Задачи 2.2 и 5.1 (Обогащение каталога, классификация категорий, LLM-judge)
LLM_MODEL_STRONG=gpt://FOLDER_ID/aliceai-llm/latest

# Задача 3.2 (Агент диагностики: вызывать с reasoning_effort="low", max_tokens=2000, timeout=30s)
LLM_MODEL_AGENT=gpt://<FOLDER_ID>/deepseek-v4.1-flash/latest
# Задача 5.1 (Генератор SYN-B по правилу A.3 + fallback-резерв; ЖЁСТКО reasoning_effort="none")
LLM_MODEL_SYNTH=gpt://FOLDER_ID/qwen3.6-35b-a3b/latest
LLM_MODEL_FALLBACK=gpt://FOLDER_ID/qwen3.6-35b-a3b/latest

# --- Ограничения из A.13 / B.7 ----------------------------------------
LLM_TIMEOUT_MS=1500
LLM_OFFLINE_TIMEOUT_MS=30000
# Дневной бюджет LLM в микро-рублях (500000000 = 300 ₽)
LLM_DAILY_BUDGET_MICRO_RUB=500000000

# --- Доступ ------------------------------------------------------------
ADMIN_TOKEN=change-me-admin
INTERNAL_TOKEN=change-me-internal

# --- Хранилище ---------------------------------------------------------
SQLITE_PATH=data/db/smart_search.sqlite