{
	admin off
	auto_https off
}

:80 {
	# API: прокси без буферизации, чтобы SSE (/v1/search/stream) уходил клиенту сразу.
	@api path /v1/* /internal/* /healthz /readyz /openapi.json /docs /docs/*
	handle @api {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	# SPA: статика из /srv/web, неизвестные пути отдают index.html.
	handle {
		root * /srv/web
		encode zstd gzip

		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		try_files {path} /index.html
		file_server
	}

	handle_errors {
		# Пока фронтенд не собран (нет /srv/web/index.html) — заглушка.
		@nofront expression {err.status_code} == 404
		handle @nofront {
			header Content-Type "text/html; charset=utf-8"
			respond `<!doctype html><html lang="ru"><head><meta charset="utf-8"><title>smart-search</title></head><body style="font-family:system-ui,sans-serif;max-width:40rem;margin:4rem auto"><h1>smart-search</h1><p>Фронтенд ещё не собран. API: <a href="/docs">/docs</a>, <a href="/readyz">/readyz</a>.</p></body></html>` 200
		}
		handle {
			respond "{err.status_code} {err.status_text}"
		}
	}
}
